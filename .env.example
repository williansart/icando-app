# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Anthropic (console.anthropic.com > API Keys). Sem ela, o app roda em modo demonstração.
ANTHROPIC_API_KEY=sk-ant-...

# Alternativa temporária: OpenAI (usada só quando ANTHROPIC_API_KEY estiver vazia)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5

# Opcional: modelo usado (padrão claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional: e-mails liberados para usar a IA, separados por vírgula. Vazio = qualquer pessoa logada.
ALLOWED_EMAILS=williansart@gmail.com
